{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node", "homey"],
    "outDir": ".homeybuild",
    "rootDir": ".",
    "sourceMap": true
  },
  "include": ["app.ts", "src/**/*.ts"],
  "exclude": ["tests/**/*.ts"]
}
